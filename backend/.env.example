# Environment Configuration for Holder Portal

# PORT
PORT=3000

# DATABASE
DATA_DIR=./

# JWT SECRET
JWT_SECRET=holder-local-secret-change-in-production

# EMAIL/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# === AI INTEGRATIONS - API KEYS ===

# OpenAI (ChatGPT)
OPENAI_API_KEY=sk-your-openai-key-here

# Google Cloud (Vision API, Gemini, Custom Search)
GOOGLE_API_KEY=your-google-api-key
GOOGLE_APPLICATION_CREDENTIALS=./path-to-google-credentials.json
GOOGLE_SEARCH_ENGINE_ID=your-custom-search-engine-id

# Anthropic (Claude)
CLAUDE_API_KEY=sk-ant-your-claude-key-here

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# YouTube API
YOUTUBE_API_KEY=your-youtube-api-key

# LinkedIn (Note: Direct API has restrictions, check enterprise permissions)
# LINKEDIN_ACCESS_TOKEN=your-linkedin-token

# Environment
NODE_ENV=development
